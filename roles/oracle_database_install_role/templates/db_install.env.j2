{# Environment file <oracle_common_env_dir>/<DATABASE_NAME>.env, rendered by tasks/env_file.yml.
   The first five lines are the ones the original playbook prepended to files/db_install.env; the
   rest is that file unchanged. ORACLE_HOME keeps the original $ORACLE_BASE/product/<version> form
   unless oracle_home was overridden (side-by-side install), in which case the path is written.
   PATH ends with "." only when oracle_database_install_role_env_path_include_cwd is true. #}
#
ORACLE_HOSTNAME=$(hostname); export ORACLE_HOSTNAME
ORACLE_SID={{ DATABASE_NAME }}; export ORACLE_SID
ORACLE_BASE={{ oracle_database_install_role_oracle_base }}; export ORACLE_BASE
ORACLE_HOME={{ '$ORACLE_BASE/product/' ~ database_version if oracle_home == oracle_database_install_role_oracle_base ~ '/product/' ~ database_version else oracle_home }}; export ORACLE_HOME

TNS_ADMIN=$ORACLE_BASE/admin/network/admin; export TNS_ADMIN
ORATAB=$TNS_ADMIN/oratab; export ORATAB # Need to set ORATAB to override the default

# $PATH must be explicitly set with no referenence to the previous $PATH
# This is because we are not using oraenv (due to VCS).  If we reference
# the old path we can end up with PATH=$ORACLE_HOME/bin:$ORACLE_HOME/bin etc.
# And the incorrect version of binaries being run.
PATH=/usr/bin:/usr/ccs/bin:/bin:/etc:/usr/openwin/bin:/usr/local/bin:/usr/bin:/usr/ucb:$ORACLE_HOME/bin:$ORACLE_HOME/OPatch{{ ':.' if oracle_database_install_role_env_path_include_cwd | bool else '' }}; export PATH

# set LB_LIBRARY_PATH for 64-bit Oracle/Solaris
LD_LIBRARY_PATH=$ORACLE_HOME/lib; export LD_LIBRARY_PATH

# set LB_LIBRARY_PATH_64 for 64-bit Oracle/Solaris
LD_LIBRARY_PATH_64=$ORACLE_HOME/lib; export LD_LIBRARY_PATH_64

# Set the LIBPATH variable as $ORACLE_HOME/lib32
LIBPATH=$ORACLE_HOME/lib; export LIBPATH

NLS_LANG=american_america.AL32UTF8; export NLS_LANG
NLS_TIMESTAMP_FORMAT="YYYY-MM-DD-HH24.MI.SS.FF6"; export NLS_TIMESTAMP_FORMAT
NLS_DATE_FORMAT="YYYY-MM-DD-HH24.MI.SS"; export NLS_DATE_FORMAT

export PS1="[$(whoami)@$(hostname)]$ "
#export PS1="[$(whoami)@$(hostname)(\$PWD)]$ "
export PATH=$PATH:/usr/sbin
