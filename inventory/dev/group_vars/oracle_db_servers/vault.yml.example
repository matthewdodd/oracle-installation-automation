---
# EXAMPLE ONLY for the dev environment - fake values, not encrypted, not loaded by Ansible (the
# .example extension is ignored). The vault_* names are already mapped in main.yml. To use it:
#
#   cp inventory/dev/group_vars/oracle_db_servers/vault.yml.example inventory/dev/group_vars/oracle_db_servers/vault.yml
#   $EDITOR inventory/dev/group_vars/oracle_db_servers/vault.yml        # real values
#   ansible-vault encrypt --vault-id dev@prompt inventory/dev/group_vars/oracle_db_servers/vault.yml
#   head -n 1 inventory/dev/group_vars/oracle_db_servers/vault.yml      # must start with $ANSIBLE_VAULT;1.2;AES256;dev
#   ansible-vault edit --vault-id dev@prompt inventory/dev/group_vars/oracle_db_servers/vault.yml   # later changes
#   ansible-playbook -i inventory/dev/hosts.yml --vault-id dev@prompt oracle_database_install.yml -e target=...
#
# Never commit an unencrypted vault.yml (CI rejects any committed vault file without the
# $ANSIBLE_VAULT; header) or a vault password file (.gitignore excludes .vault_pass* / vault_pass*).
# Use a dev-only vault password, different from every other environment. Rotate with
#   ansible-vault rekey --vault-id dev@prompt --new-vault-id dev@prompt inventory/dev/group_vars/oracle_db_servers/vault.yml
# AAP: create a Vault credential with Vault Identifier "dev" and the dev vault password, and attach it
# to the dev job template (no --vault-id option is needed there).
vault_oracle_notification_webhook_url: https://example.invalid/workflows/FAKE-DEV-WEBHOOK-ID
vault_oracle_artifactory_username: example-dev-user
vault_oracle_artifactory_password: example-not-a-real-password
